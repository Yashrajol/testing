# Frontend Environment Variables
VITE_API_URL=http://localhost:5000
VITE_APP_ENV=production
VITE_ENABLE_ANALYTICS=true
VITE_SENTRY_DSN=

# Backend & Database Configurations
NODE_ENV=production
PORT=5000
DATABASE_URL=postgresql://postgres:prod_secure_password_123@localhost:5432/vedhkrit_production?schema=public
REDIS_URL=redis://:redis_prod_password_123@localhost:6379

# Security & Secrets
JWT_SECRET=super_secret_jwt_key_change_in_production_32bytes
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_32bytes
SESSION_SECRET=super_secret_session_key
CORS_ORIGINS=https://app.vedhkrit.com,http://localhost:8080

# Cloud & Storage (S3 / R2 compatible)
STORAGE_ENDPOINT=https://s3.amazonaws.com
STORAGE_BUCKET=vedhkrit-media-assets
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
