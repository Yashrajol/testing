// prisma/schema/assignment.prisma

enum AssignmentCategory {
  HOMEWORK
  CLASSWORK
  PROJECT
  PRACTICAL
  LAB_ASSIGNMENT
  GROUP_ASSIGNMENT
  INDIVIDUAL_ASSIGNMENT
  CAPSTONE_PROJECT
}

enum AssignmentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  CLOSED
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  GRADED
  RETURNED
  REOPENED
  OVERDUE
}

enum GradingType {
  MANUAL
  RUBRIC_BASED
  AUTO_GRADED
}

model Assignment {
  id                         String             @id @default(uuid())
  organizationId             String?
  tenantId                   String?
  title                      String
  description                String?            @db.Text
  category                   AssignmentCategory @default(HOMEWORK)
  status                     AssignmentStatus   @default(DRAFT)
  batchId                    String?
  classId                    String?
  subjectId                  String?
  teacherId                  String?
  totalPoints                Float              @default(100.0)
  passingPoints              Float?
  gradingType                GradingType        @default(MANUAL)
  isGroupAssignment          Boolean            @default(false)
  maxGroupSize               Int?
  allowLateSubmission        Boolean            @default(true)
  latePenaltyPercentPerDay   Float?             @default(5.0)
  maxSubmissions             Int                @default(3)
  dueDate                    DateTime
  publishedAt                DateTime?
  archivedAt                 DateTime?
  gitRepoUrl                 String?
  metadata                   Json?
  createdById                String?
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt
  deletedAt                  DateTime?

  submissions                Submission[]
  rubrics                    AssignmentRubric[]
  attachments                Attachment[]
  extensions                 DeadlineExtension[]

  @@index([organizationId])
  @@index([tenantId])
  @@index([batchId])
  @@index([classId])
  @@index([subjectId])
  @@index([status])
  @@index([dueDate])
}

model Submission {
  id                 String           @id @default(uuid())
  assignmentId       String
  assignment         Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId          String
  student            StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  attemptNumber      Int              @default(1)
  richTextContent    String?          @db.Text
  externalUrl        String?
  gitRepositoryUrl   String?
  gitCommitHash      String?
  status             SubmissionStatus @default(SUBMITTED)
  isLate             Boolean          @default(false)
  score              Float?
  isGraded           Boolean          @default(false)
  gradedAt           DateTime?
  gradedById         String?
  metadata           Json?
  submittedAt        DateTime         @default(now())
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  deletedAt          DateTime?

  attachments        Attachment[]
  feedbacks          Feedback[]

  @@index([assignmentId])
  @@index([studentId])
  @@index([status])
  @@index([submittedAt])
}

model AssignmentRubric {
  id              String            @id @default(uuid())
  assignmentId    String
  assignment      Assignment        @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  totalMaxPoints  Float
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?

  criteria        RubricCriterion[]

  @@index([assignmentId])
}

model RubricCriterion {
  id          String           @id @default(uuid())
  rubricId    String
  rubric      AssignmentRubric @relation(fields: [rubricId], references: [id], onDelete: Cascade)
  title       String
  description String?
  maxPoints   Float
  weightage   Float            @default(1.0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?

  @@index([rubricId])
}

model Feedback {
  id               String     @id @default(uuid())
  submissionId     String
  submission       Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  authorId         String
  authorType       String     @default("TEACHER") // TEACHER, PEER, AI
  comment          String     @db.Text
  criteriaScores   Json?
  audioFeedbackUrl String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  deletedAt        DateTime?

  @@index([submissionId])
}

model Attachment {
  id           String      @id @default(uuid())
  assignmentId String?
  assignment   Assignment? @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  submissionId String?
  submission   Submission? @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  fileName     String
  fileUrl      String
  fileType     String
  fileSizeBytes Int?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  deletedAt    DateTime?

  @@index([assignmentId])
  @@index([submissionId])
}

model AssignmentAnalytics {
  id                  String   @id @default(uuid())
  organizationId      String?
  tenantId            String?
  assignmentId        String?
  batchId             String?
  classId             String?
  studentId           String?
  totalAssigned       Int      @default(0)
  totalSubmitted      Int      @default(0)
  totalGraded         Int      @default(0)
  submissionRate      Float    @default(0.0)
  completionRate      Float    @default(0.0)
  lateSubmissionRate  Float    @default(0.0)
  averageScore        Float    @default(0.0)
  rubricAnalytics     Json?
  topicWeaknesses     Json?
  lastCalculatedAt    DateTime @default(now())
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  deletedAt           DateTime?

  @@index([organizationId])
  @@index([assignmentId])
  @@index([batchId])
  @@index([studentId])
}
