// prisma/schema/assessment.prisma

model QuestionBank {
  id             String       @id @default(uuid())
  title          String
  description    String?
  category       String?
  subjectId      String?
  chapterId      String?
  topicId        String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  questions      Question[]
}

model Question {
  id                  String             @id @default(uuid())
  bankId              String?
  bank                QuestionBank?      @relation(fields: [bankId], references: [id], onDelete: Cascade)
  type                String             @default("MCQ") // MCQ, TRUE_FALSE, SHORT_ANSWER, LONG_ANSWER, CODING, FILE_UPLOAD, MATCHING, FILL_IN_BLANKS
  text                String             @db.Text
  options             Json?              // Array of choices or matching pairs
  correctAnswer       String?
  difficulty          String             @default("MEDIUM") // EASY, MEDIUM, HARD
  bloomsTaxonomy      String             @default("KNOWLEDGE") // KNOWLEDGE, COMPREHENSION, APPLICATION, ANALYSIS, SYNTHESIS, EVALUATION
  learningObjectiveId String?
  estimatedSeconds    Int?               @default(60)
  marks               Float              @default(1.0)
  negativeMarks       Float              @default(0.0)
  tags                String[]
  hints               String[]
  explanation         String?            @db.Text
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  deletedAt           DateTime?

  answers             Answer[]
  studentAnswers      StudentAnswer[]

  @@index([bankId])
}

model Assessment {
  id              String              @id @default(uuid())
  title           String
  description     String?             @db.Text
  type            String              @default("QUIZ") // QUIZ, PRACTICE_TEST, EXAM, ASSIGNMENT
  timeLimitMins   Int?
  totalMarks      Float               @default(100.0)
  passPercentage  Float               @default(40.0)
  startDate       DateTime?
  endDate         DateTime?
  instructions    String?             @db.Text
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  deletedAt       DateTime?

  attempts        AssessmentAttempt[]
  rubrics         Rubric[]
}

model AssessmentAttempt {
  id                  String            @id @default(uuid())
  assessmentId        String
  assessment          Assessment        @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  studentId           String
  student             StudentProfile    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  startTime           DateTime          @default(now())
  endTime             DateTime?
  durationSeconds     Int?
  totalScore          Float?            @default(0.0)
  percentage          Float?            @default(0.0)
  status              String            @default("IN_PROGRESS") // IN_PROGRESS, SUBMITTED, EVALUATED, EXPIRED
  competencyBreakdown Json?
  questionAnalytics   Json?
  learningOutcome     String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  deletedAt           DateTime?

  answers             Answer[]
  gradings            Grading[]
  competencyScores    CompetencyScore[]

  @@index([assessmentId])
  @@index([studentId])
}

model Answer {
  id               String            @id @default(uuid())
  attemptId        String
  attempt          AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId       String
  question         Question          @relation(fields: [questionId], references: [id], onDelete: Restrict)
  responseValue    String?           @db.Text
  fileUrl          String?
  isCorrect        Boolean?
  marksObtained    Float?            @default(0.0)
  feedback         String?           @db.Text
  savedAt          DateTime          @default(now())
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?

  @@index([attemptId])
  @@index([questionId])
}

model Rubric {
  id           String     @id @default(uuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  criteriaName String
  maxPoints    Float
  description  String?    @db.Text
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  @@index([assessmentId])
}

model Grading {
  id             String            @id @default(uuid())
  attemptId      String
  attempt        AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  evaluatorId    String?
  evaluatorType  String            @default("AUTO") // AUTO, MANUAL
  scoreGranted   Float
  comments       String?           @db.Text
  evaluatedAt    DateTime          @default(now())
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deletedAt      DateTime?

  @@index([attemptId])
}

model CompetencyScore {
  id             String            @id @default(uuid())
  attemptId      String
  attempt        AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  competencyName String
  score          Float
  maxScore       Float
  percentage     Float
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deletedAt      DateTime?

  @@index([attemptId])
}

model StudentAnswer {
  id             String         @id @default(uuid())
  studentId      String
  student        StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  questionId     String
  question       Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedAnswer String
  isCorrect      Boolean
  answeredAt     DateTime       @default(now())
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([studentId])
  @@index([questionId])
}

model AssessmentResult {
  id              String         @id @default(uuid())
  studentId       String
  student         StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title           String
  overallScore    Float
  dimensions      Json?          // e.g., { "problemSolving": 80, "analytical": 75 }
  status          String         @default("COMPLETED") // PENDING, COMPLETED
  takenAt         DateTime       @default(now())
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([studentId])
}
