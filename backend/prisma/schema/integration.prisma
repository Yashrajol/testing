// prisma/schema/integration.prisma

enum ConnectorType {
  GOOGLE_CLASSROOM
  MOODLE
  STRIPE
  TWILIO
  S3
  OAUTH
}

enum SyncStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model Connector {
  id           String        @id @default(uuid())
  name         String
  type         ConnectorType
  category     String // EDUCATION, COMMUNICATION, STORAGE, PAYMENTS, IDENTITY
  description  String?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  integrations Integration[]
}

model Integration {
  id             String      @id @default(uuid())
  organizationId String?
  tenantId       String?
  connectorId    String
  connector      Connector   @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  config         Json // Credentials, tokens, OAuth scopes
  status         String      @default("ACTIVE") // ACTIVE, ERROR, SUSPENDED
  lastSyncedAt   DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  deletedAt      DateTime?
  syncJobs       SyncJob[]

  @@index([organizationId])
  @@index([tenantId])
  @@index([connectorId])
}

model Webhook {
  id             String    @id @default(uuid())
  organizationId String?
  tenantId       String?
  url            String
  events         String[] // Triggering topics: ['student.registered', 'attendance.marked']
  secret         String
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  @@index([organizationId])
  @@index([tenantId])
}

model SyncJob {
  id            String      @id @default(uuid())
  integrationId String
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  status        SyncStatus  @default(PENDING)
  recordsSynced Int         @default(0)
  errorMessage  String?
  startedAt     DateTime    @default(now())
  completedAt   DateTime?
  createdAt     DateTime    @default(now())

  @@index([integrationId])
}

model ApiKey {
  id             String    @id @default(uuid())
  organizationId String?
  tenantId       String?
  name           String
  keyHash        String    @unique
  scopes         String[]
  expiresAt      DateTime?
  isActive       Boolean   @default(true)
  lastUsedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  @@index([organizationId])
  @@index([tenantId])
  @@index([keyHash])
}
