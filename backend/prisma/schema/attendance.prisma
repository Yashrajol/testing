// prisma/schema/attendance.prisma

enum AttendanceType {
  DAILY
  SUBJECT_WISE
  LECTURE
  BATCH
  CLASS
  TEACHER
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  MEDICAL_LEAVE
  APPROVED_LEAVE
  HOLIDAY
  EXCUSED
}

enum AttendanceMode {
  MANUAL
  QR_CODE
  GEOFENCE
  FACE_RECOGNITION
  BIOMETRIC
}

enum LeaveType {
  STUDENT_LEAVE
  TEACHER_LEAVE
  MEDICAL
  CASUAL
  SICK
  SPECIAL
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum HolidayType {
  NATIONAL
  SCHOOL
  ACADEMIC_CALENDAR
  ORGANIZATION
  EXAM
}

model AttendanceSession {
  id             String           @id @default(uuid())
  organizationId String?
  tenantId       String?
  type           AttendanceType   @default(DAILY)
  title          String
  batchId        String?
  subjectId      String?
  classId        String?
  teacherId      String?
  date           DateTime         @default(now())
  startTime      DateTime?
  endTime        DateTime?
  qrCode         String?
  geofenceLat    Float?
  geofenceLng    Float?
  geofenceRadius Float?           // radius in meters
  status         String           @default("OPEN") // OPEN, CLOSED
  closedAt       DateTime?
  metadata       Json?
  createdById    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?

  records AttendanceRecord[]

  @@index([organizationId])
  @@index([tenantId])
  @@index([batchId])
  @@index([date])
  @@index([status])
}

model AttendanceRecord {
  id             String           @id @default(uuid())
  sessionId      String?
  session        AttendanceSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  organizationId String?
  tenantId       String?
  studentId      String?
  student        StudentProfile?  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacherId      String?
  batchId        String?
  subjectId      String?
  classId        String?
  type           AttendanceType   @default(DAILY)
  status         AttendanceStatus @default(PRESENT)
  mode           AttendanceMode   @default(MANUAL)
  date           DateTime         @default(now())
  markedAt       DateTime         @default(now())
  markedById     String?
  remarks        String?
  locationLat    Float?
  locationLng    Float?
  deviceInfo     Json?
  biometricHash  String?
  verificationScore Float?
  isCorrected    Boolean          @default(false)
  correctedById  String?
  correctionReason String?
  metadata       Json?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?

  @@index([organizationId])
  @@index([tenantId])
  @@index([studentId])
  @@index([teacherId])
  @@index([batchId])
  @@index([date])
  @@index([status])
}

model LeaveRequest {
  id              String         @id @default(uuid())
  organizationId  String?
  tenantId        String?
  applicantId     String         // Student or Teacher ID
  studentId       String?
  student         StudentProfile? @relation(fields: [studentId], references: [id], onDelete: Cascade)
  applicantType   String         @default("STUDENT") // STUDENT, TEACHER
  leaveType       LeaveType      @default(CASUAL)
  startDate       DateTime
  endDate         DateTime
  totalDays       Float
  reason          String
  attachmentUrls  String[]
  status          LeaveStatus    @default(PENDING)
  approvedById    String?
  rejectionReason String?
  appliedAt       DateTime       @default(now())
  reviewedAt      DateTime?
  metadata        Json?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?

  @@index([organizationId])
  @@index([tenantId])
  @@index([applicantId])
  @@index([status])
  @@index([startDate, endDate])
}

model Holiday {
  id             String      @id @default(uuid())
  organizationId String?
  tenantId       String?
  title          String
  description    String?
  date           DateTime
  endDate        DateTime?
  type           HolidayType @default(SCHOOL)
  isRecurring    Boolean     @default(false)
  affectsClasses Boolean     @default(true)
  metadata       Json?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  deletedAt      DateTime?

  @@index([organizationId])
  @@index([tenantId])
  @@index([date])
  @@index([type])
}

model AttendancePolicy {
  id                   String   @id @default(uuid())
  organizationId       String?
  tenantId             String?
  name                 String
  minAttendancePercentage Float  @default(75.0)
  lateThresholdMinutes Int      @default(15)
  halfDayThresholdMinutes Int   @default(120)
  autoMarkAbsentAfter  String?  // e.g. "10:30 AM"
  allowSelfCheckIn     Boolean  @default(false)
  enableGeofencing     Boolean  @default(false)
  defaultGeofenceRadius Float?  @default(100.0) // meters
  enableQrCheckIn      Boolean  @default(true)
  enableBiometricCheckIn Boolean @default(false)
  metadata             Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  deletedAt            DateTime?

  @@index([organizationId])
  @@index([tenantId])
}

model AttendanceAnalytics {
  id                    String   @id @default(uuid())
  organizationId        String?
  tenantId              String?
  studentId             String?
  teacherId             String?
  classId               String?
  batchId               String?
  subjectId             String?
  period                String   // e.g., "2026-07", "DAILY-2026-07-21"
  totalDays             Int      @default(0)
  presentDays           Int      @default(0)
  absentDays            Int      @default(0)
  lateDays              Int      @default(0)
  halfDays              Int      @default(0)
  leaveDays             Int      @default(0)
  attendancePercentage  Float    @default(0.0)
  consecutiveAbsences   Int      @default(0)
  isDefaulter           Boolean  @default(false)
  riskScore             Float    @default(0.0)
  trends                Json?
  heatmap               Json?
  lastCalculatedAt      DateTime @default(now())
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  deletedAt             DateTime?

  @@index([organizationId])
  @@index([studentId])
  @@index([period])
  @@index([isDefaulter])
}
