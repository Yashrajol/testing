// prisma/schema/notification.prisma

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  WHATSAPP
  PUSH
  WEBSOCKET
}

enum NotificationType {
  ASSESSMENT_PUBLISHED
  ASSESSMENT_REMINDER
  ASSIGNMENT_CREATED
  ASSIGNMENT_DUE
  ASSIGNMENT_GRADED
  ATTENDANCE_ALERT
  LOW_ATTENDANCE_WARNING
  LEAVE_APPROVED
  LEAVE_REJECTED
  LEARNING_DNA_UPDATED
  VEDHKRIT_INDEX_UPDATED
  CAREER_RECOMMENDATION_UPDATED
  GOAL_ACHIEVED
  CERTIFICATE_ISSUED
  PAYMENT_REMINDER
  FEE_DUE
  SCHOOL_ANNOUNCEMENT
  ORGANIZATION_ANNOUNCEMENT
  SYSTEM_ANNOUNCEMENT
}

enum NotificationPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum DeliveryStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
  RETRYING
  DEAD_LETTER
}

enum TargetAudienceRole {
  ALL
  STUDENT
  TEACHER
  PARENT
  MENTOR
  ADMIN
}

model Notification {
  id               String               @id @default(uuid())
  organizationId   String?
  tenantId         String?
  recipientId      String
  recipientRole    TargetAudienceRole   @default(STUDENT)
  type             NotificationType
  title            String
  body             String               @db.Text
  actionUrl        String?
  channel          NotificationChannel  @default(IN_APP)
  priority         NotificationPriority @default(MEDIUM)
  status           DeliveryStatus       @default(PENDING)
  isRead           Boolean              @default(false)
  readAt           DateTime?
  scheduledFor     DateTime?
  metadata         Json?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  deletedAt        DateTime?

  logs             DeliveryLog[]

  @@index([recipientId])
  @@index([organizationId])
  @@index([tenantId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
}

model NotificationTemplate {
  id            String              @id @default(uuid())
  code          String              @unique
  name          String
  type          NotificationType
  channel       NotificationChannel
  subject       String?
  htmlBody      String?             @db.Text
  textBody      String?             @db.Text
  pushTitle     String?
  whatsappBody  String?             @db.Text
  smsBody       String?             @db.Text
  variables     Json?
  language      String              @default("en")
  isActive      Boolean             @default(true)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  deletedAt     DateTime?

  @@index([code])
  @@index([type])
}

model NotificationPreference {
  id                  String               @id @default(uuid())
  userId              String               @unique
  enabledChannels     Json?
  categoryPreferences Json?
  quietHoursStart     String?
  quietHoursEnd       String?
  minPriority         NotificationPriority @default(LOW)
  preferredLanguage   String               @default("en")
  frequency           String               @default("IMMEDIATE")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  deletedAt           DateTime?

  @@index([userId])
}

model Announcement {
  id             String             @id @default(uuid())
  organizationId String?
  schoolId       String?
  classId        String?
  batchId        String?
  courseId       String?
  targetRole     TargetAudienceRole @default(ALL)
  targetUserId   String?
  title          String
  content        String             @db.Text
  authorId       String
  isPublished    Boolean            @default(false)
  publishedAt    DateTime?
  expiresAt      DateTime?
  attachments    Json?
  metadata       Json?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  deletedAt      DateTime?

  @@index([organizationId])
  @@index([schoolId])
  @@index([classId])
  @@index([batchId])
  @@index([targetRole])
  @@index([targetUserId])
}

model DeliveryLog {
  id             String              @id @default(uuid())
  notificationId String
  notification   Notification        @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  channel        NotificationChannel
  status         DeliveryStatus      @default(PENDING)
  provider       String?
  providerMsgId  String?
  errorMessage   String?             @db.Text
  attemptCount   Int                 @default(1)
  nextAttemptAt  DateTime?
  sentAt         DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([notificationId])
  @@index([status])
}
