}

// prisma/schema/growth.prisma

model StudentProfile {
  id               String         @id @default(uuid())
  userId           String         @unique
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName        String?
  middleName       String?
  lastName         String?
  gender           String?
  dateOfBirth      DateTime?
  profilePhoto     String?
  address          String?
  emergencyContact String?
  bloodGroup       String?
  nationality      String?
  language         String?
  timezone         String?        @default("UTC")
  metadata         Json?
  admissionNumber  String?
  rollNumber       String?
  organizationId   String?
  schoolId         String?
  grade            String?
  schoolName       String?
  parentLinkId     String?
  parent           ParentProfile? @relation(fields: [parentLinkId], references: [id], onDelete: SetNull)
  membershipId     String?
  membership       Membership?    @relation(fields: [membershipId], references: [id])
  batchId          String?
  batch            Batch?         @relation(fields: [batchId], references: [id])
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  deletedAt        DateTime?

  assessmentResults  AssessmentResult[]
  goals              Goal[]
  badges             Badge[]
  mentorSessions     MentorSession[]
  academicRecords    AcademicRecord[]
  consentRecords     ConsentRecord[]
  studentAnswers     StudentAnswer[]
  attendanceRecords  AttendanceRecord[]
  leaveRequests      LeaveRequest[]
  enrollments        Enrollment[]
  assessmentAttempts AssessmentAttempt[]
  submissions        Submission[]
  deadlineExtensions DeadlineExtension[]
  velocityLogs       LearningVelocityLog[]
  learningDna        LearningDNA?
  adaptiveNodes      AdaptivePathNode[]
  vedhkritIndex      VedhkritIndex?
  careerProfile      CareerProfile?
  milestones         Milestone[]

  @@index([parentLinkId])
  @@index([membershipId])
  @@index([batchId])
  @@index([organizationId])
}

model ParentProfile {
  id                String           @id @default(uuid())
  userId            String           @unique
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName         String?
  middleName        String?
  lastName          String?
  gender            String?
  dateOfBirth       DateTime?
  profilePhoto      String?
  address           String?
  emergencyContact  String?
  bloodGroup        String?
  nationality       String?
  language          String?
  timezone          String?          @default("UTC")
  metadata          Json?
  occupation        String?
  relationToStudent String?
  children          StudentProfile[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  deletedAt         DateTime?
}

model MentorProfile {
  id                String         @id @default(uuid())
  userId            String         @unique
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName         String?
  middleName        String?
  lastName          String?
  gender            String?
  dateOfBirth       DateTime?
  profilePhoto      String?
  address           String?
  emergencyContact  String?
  bloodGroup        String?
  nationality       String?
  language          String?
  timezone          String?        @default("UTC")
  metadata          Json?
  expertise         String[]
  yearsOfExperience Int?           @default(0)
  resumeUrl         String?
  approvalStatus    ApprovalStatus @default(PENDING_REVIEW)
  approvedAt        DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  deletedAt         DateTime?

  mentorSessions MentorSession[]
}

model StaffProfile {
  id               String    @id @default(uuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName        String?
  middleName       String?
  lastName         String?
  gender           String?
  dateOfBirth      DateTime?
  profilePhoto     String?
  address          String?
  emergencyContact String?
  bloodGroup       String?
  nationality      String?
  language         String?
  timezone         String?   @default("UTC")
  metadata         Json?
  department       String?
  employeeId       String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?
}

model LearningDNA {
  id                   String         @id @default(uuid())
  studentProfileId     String         @unique
  student              StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  softSkillMatrix      Json? // e.g. { "leadership": 80, "consistency": 75 }
  primaryLearningStyle String         @default("VISUAL") // VISUAL, AUDITORY, KINESTHETIC, READING_WRITING
  preferredMode        String         @default("INTERACTIVE_PRACTICE")
  masteryScore         Float          @default(75.0)
  growthScore          Float          @default(80.0)
  confidenceScore      Float          @default(85.0)
  retentionScore       Float          @default(82.0)
  riskScore            Float          @default(15.0)
  knowledgeGraph       Json?
  skillProfile         Json?
  competencyProfile    Json?
  recommendations      Json?
  lastCalculatedAt     DateTime       @default(now())
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  deletedAt            DateTime?

  knowledgeProfiles   KnowledgeProfile[]
  competencyProfiles  CompetencyProfile[]
  masteryProfiles     MasteryProfile[]
  riskProfiles        RiskProfile[]
  recommendationItems Recommendation[]
  learningPatterns    LearningPattern[]
  learningMetricsList LearningMetrics[]
}

model VedhkritIndex {
  id               String         @id @default(uuid())
  studentProfileId String         @unique
  student          StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  score            Float          @default(750.0) // 0-1000
  growthRate       Float          @default(12.5)
  readinessLevel   String         @default("READY")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model CareerProfile {
  id              String         @id @default(uuid())
  studentId       String         @unique
  student         StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  topMatches      Json? // e.g. [{ "role": "Data Scientist", "matchPercentage": 92 }]
  skillRadar      Json? // e.g. { "Coding": 85, "Math": 90, "Logic": 88 }
  competencyRadar Json? // e.g. { "Problem Solving": 90, "Communication": 75 }
  careerReadiness Float          @default(85.0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([studentId])
}

model Milestone {
  id         String         @id @default(uuid())
  studentId  String
  student    StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title      String
  targetDate DateTime
  achievedAt DateTime?
  status     String         @default("PENDING") // PENDING, ACHIEVED, OVERDUE
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([studentId])
}

model Goal {
  id          String         @id @default(uuid())
  studentId   String
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title       String
  description String?
  targetDate  DateTime?
  progress    Float          @default(0) // 0 to 100
  status      String         @default("ON_TRACK") // ON_TRACK, AT_RISK, COMPLETED
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([studentId])
}

model Badge {
  id        String         @id @default(uuid())
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title     String
  imageUrl  String?
  earnedAt  DateTime       @default(now())
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([studentId])
}

model MentorSession {
  id          String         @id @default(uuid())
  studentId   String
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  mentorId    String
  mentor      MentorProfile  @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  topic       String
  scheduledAt DateTime
  status      String         @default("SCHEDULED") // SCHEDULED, COMPLETED, CANCELLED
  notes       String?        @db.Text
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([studentId])
  @@index([mentorId])
}

model ConsentRecord {
  id        String         @id @default(uuid())
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  type      String // e.g., "AUDIO_RECORDING", "VIDEO_TELEMETRY"
  granted   Boolean        @default(false)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([studentId])
}

model PricingPlan {
  id           String        @id @default(uuid())
  name         String
  priceINR     Float
  billingCycle String // MONTHLY, ANNUALLY
  features     String[]
  isActive     Boolean       @default(true)
  memberships  Membership[]
  transactions Transaction[]
}

model Membership {
  id        String             @id @default(uuid())
  planId    String
  plan      PricingPlan        @relation(fields: [planId], references: [id])
  status    SubscriptionStatus @default(INACTIVE)
  startedAt DateTime?
  expiresAt DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  students StudentProfile[]

  @@index([planId])
}

model Transaction {
  id         String      @id @default(uuid())
  orderId    String      @unique
  paymentId  String?     @unique
  planId     String
  plan       PricingPlan @relation(fields: [planId], references: [id])
  amount     Float
  currency   String      @default("INR")
  status     String // PENDING, SUCCESSFUL, FAILED, REFUNDED
  rawPayload Json?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([planId])
}

model CmsPage {
  id        String       @id @default(uuid())
  slug      String       @unique // e.g. "homepage", "about"
  title     String
  metaTitle String?
  metaDesc  String?
  sections  CmsSection[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model CmsSection {
  id          String   @id @default(uuid())
  pageId      String
  page        CmsPage  @relation(fields: [pageId], references: [id], onDelete: Cascade)
  sectionName String // HERO, PILLARS, PATHWAYS, STEPS, SEC_COE, logo_groups, NEWSLETTER, FOOTER
  layoutIndex Int      @default(0)
  title       String?
  subtitle    String?
  desc        String?  @db.Text
  ctaLabel    String?
  ctaLink     String?
  cards       Json?
  createdAt   DateTime @default(now()) @db.Timestamp
  updatedAt   DateTime @updatedAt @db.Timestamp

  @@index([pageId])
}

model ContactQuery {
  id         String   @id @default(uuid())
  name       String
  email      String
  phone      String?
  subject    String?
  message    String   @db.Text
  isResolved Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model LearningVelocityLog {
  id            String         @id @default(uuid())
  studentId     String
  student       StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  topicId       String?
  velocityScore Float          @default(1.0)
  timeSpentMins Int            @default(0)
  loggedAt      DateTime       @default(now())

  @@index([studentId])
}

model AdaptivePathNode {
  id                String         @id @default(uuid())
  studentId         String
  student           StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  topicId           String
  recommendedAction String // REVISION, PRACTICE_QUIZ, ADVANCED_LESSON, CONCEPT_VIDEO
  priority          Int            @default(1)
  status            String         @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([studentId])
}

model KnowledgeProfile {
  id            String      @id @default(uuid())
  learningDnaId String
  learningDna   LearningDNA @relation(fields: [learningDnaId], references: [id], onDelete: Cascade)
  topicId       String
  topicName     String
  masteryLevel  Float       @default(0.0)
  strongTopics  String[]
  weakTopics    String[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?

  @@index([learningDnaId])
}

model CompetencyProfile {
  id             String      @id @default(uuid())
  learningDnaId  String
  learningDna    LearningDNA @relation(fields: [learningDnaId], references: [id], onDelete: Cascade)
  competencyName String
  level          String      @default("INTERMEDIATE") // NOVICE, INTERMEDIATE, ADVANCED, EXPERT
  score          Float       @default(75.0)
  gapAnalysis    String?     @db.Text
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  deletedAt      DateTime?

  @@index([learningDnaId])
}

model MasteryProfile {
  id             String      @id @default(uuid())
  learningDnaId  String
  learningDna    LearningDNA @relation(fields: [learningDnaId], references: [id], onDelete: Cascade)
  subjectId      String
  masteryScore   Float       @default(0.0)
  retentionScore Float       @default(0.0)
  velocityScore  Float       @default(1.0)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  deletedAt      DateTime?

  @@index([learningDnaId])
}

model RiskProfile {
  id            String      @id @default(uuid())
  learningDnaId String
  learningDna   LearningDNA @relation(fields: [learningDnaId], references: [id], onDelete: Cascade)
  riskScore     Float       @default(0.0)
  riskLevel     String      @default("LOW") // LOW, MEDIUM, HIGH
  reasons       String[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?

  @@index([learningDnaId])
}

model Recommendation {
  id            String      @id @default(uuid())
  learningDnaId String
  learningDna   LearningDNA @relation(fields: [learningDnaId], references: [id], onDelete: Cascade)
  title         String
  description   String      @db.Text
  actionType    String // REVISION, PRACTICE_QUIZ, ADVANCED_LESSON, CONCEPT_VIDEO
  priority      String      @default("MEDIUM") // LOW, MEDIUM, HIGH
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?

  @@index([learningDnaId])
}

model LearningPattern {
  id                   String      @id @default(uuid())
  learningDnaId        String
  learningDna          LearningDNA @relation(fields: [learningDnaId], references: [id], onDelete: Cascade)
  preferredTimeOfDay   String      @default("EVENING") // MORNING, AFTERNOON, EVENING, NIGHT
  preferredContentType String      @default("INTERACTIVE")
  consistencyScore     Float       @default(80.0)
  engagementScore      Float       @default(85.0)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  deletedAt            DateTime?

  @@index([learningDnaId])
}

model LearningMetrics {
  id                 String      @id @default(uuid())
  learningDnaId      String
  learningDna        LearningDNA @relation(fields: [learningDnaId], references: [id], onDelete: Cascade)
  confidenceScore    Float       @default(80.0)
  adaptiveDifficulty String      @default("MEDIUM") // EASY, MEDIUM, HARD
  totalStudyMins     Int         @default(0)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  deletedAt          DateTime?

  @@index([learningDnaId])
}

// prisma/schema/integration.prisma

enum ConnectorType {
  GOOGLE_CLASSROOM
  MOODLE
  STRIPE
  TWILIO
  S3
  OAUTH
}

enum SyncStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model Connector {
  id           String        @id @default(uuid())
  name         String
  type         ConnectorType
  category     String // EDUCATION, COMMUNICATION, STORAGE, PAYMENTS, IDENTITY
  description  String?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  integrations Integration[]
}

model Integration {
  id             String    @id @default(uuid())
  organizationId String?
  tenantId       String?
  connectorId    String
  connector      Connector @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  config         Json // Credentials, tokens, OAuth scopes
  status         String    @default("ACTIVE") // ACTIVE, ERROR, SUSPENDED
  lastSyncedAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  syncJobs       SyncJob[]

  @@index([organizationId])
  @@index([tenantId])
  @@index([connectorId])
}

model Webhook {
  id             String    @id @default(uuid())
  organizationId String?
  tenantId       String?
  url            String
  events         String[] // Triggering topics: ['student.registered', 'attendance.marked']
  secret         String
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  @@index([organizationId])
  @@index([tenantId])
}

model SyncJob {
  id            String      @id @default(uuid())
  integrationId String
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  status        SyncStatus  @default(PENDING)
  recordsSynced Int         @default(0)
  errorMessage  String?
  startedAt     DateTime    @default(now())
  completedAt   DateTime?
  createdAt     DateTime    @default(now())

  @@index([integrationId])
}

model ApiKey {
  id             String    @id @default(uuid())
  organizationId String?
  tenantId       String?
  name           String
  keyHash        String    @unique
  scopes         String[]
  expiresAt      DateTime?
  isActive       Boolean   @default(true)
  lastUsedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  @@index([organizationId])
  @@index([tenantId])
  @@index([keyHash])
}

// prisma/schema/notification.prisma

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  WHATSAPP
  PUSH
  WEBSOCKET
}

enum NotificationType {
  ASSESSMENT_PUBLISHED
  ASSESSMENT_REMINDER
  ASSIGNMENT_CREATED
  ASSIGNMENT_DUE
  ASSIGNMENT_GRADED
  ATTENDANCE_ALERT
  LOW_ATTENDANCE_WARNING
  LEAVE_APPROVED
  LEAVE_REJECTED
  LEARNING_DNA_UPDATED
  VEDHKRIT_INDEX_UPDATED
  CAREER_RECOMMENDATION_UPDATED
  GOAL_ACHIEVED
  CERTIFICATE_ISSUED
  PAYMENT_REMINDER
  FEE_DUE
  SCHOOL_ANNOUNCEMENT
  ORGANIZATION_ANNOUNCEMENT
  SYSTEM_ANNOUNCEMENT
}

enum NotificationPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum DeliveryStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
  RETRYING
  DEAD_LETTER
}

enum TargetAudienceRole {
  ALL
  STUDENT
  TEACHER
  PARENT
  MENTOR
  ADMIN
}

model Notification {
  id             String               @id @default(uuid())
  organizationId String?
  tenantId       String?
  recipientId    String
  recipientRole  TargetAudienceRole   @default(STUDENT)
  type           NotificationType
  title          String
  body           String               @db.Text
  actionUrl      String?
  channel        NotificationChannel  @default(IN_APP)
  priority       NotificationPriority @default(MEDIUM)
  status         DeliveryStatus       @default(PENDING)
  isRead         Boolean              @default(false)
  readAt         DateTime?
  scheduledFor   DateTime?
  metadata       Json?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  deletedAt      DateTime?

  logs DeliveryLog[]

  @@index([recipientId])
  @@index([organizationId])
  @@index([tenantId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
}

model NotificationTemplate {
  id           String              @id @default(uuid())
  code         String              @unique
  name         String
  type         NotificationType
  channel      NotificationChannel
  subject      String?
  htmlBody     String?             @db.Text
  textBody     String?             @db.Text
  pushTitle    String?
  whatsappBody String?             @db.Text
  smsBody      String?             @db.Text
  variables    Json?
  language     String              @default("en")
  isActive     Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  deletedAt    DateTime?

  @@index([code])
  @@index([type])
}

model NotificationPreference {
  id                  String               @id @default(uuid())
  userId              String               @unique
  enabledChannels     Json?
  categoryPreferences Json?
  quietHoursStart     String?
  quietHoursEnd       String?
  minPriority         NotificationPriority @default(LOW)
  preferredLanguage   String               @default("en")
  frequency           String               @default("IMMEDIATE")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  deletedAt           DateTime?

  @@index([userId])
}

model Announcement {
  id             String             @id @default(uuid())
  organizationId String?
  schoolId       String?
  classId        String?
  batchId        String?
  courseId       String?
  targetRole     TargetAudienceRole @default(ALL)
  targetUserId   String?
  title          String
  content        String             @db.Text
  authorId       String
  isPublished    Boolean            @default(false)
  publishedAt    DateTime?
  expiresAt      DateTime?
  attachments    Json?
  metadata       Json?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  deletedAt      DateTime?

  @@index([organizationId])
  @@index([schoolId])
  @@index([classId])
  @@index([batchId])
  @@index([targetRole])
  @@index([targetUserId])
}

model DeliveryLog {
  id             String              @id @default(uuid())
  notificationId String
  notification   Notification        @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  channel        NotificationChannel
  status         DeliveryStatus      @default(PENDING)
  provider       String?
  providerMsgId  String?
  errorMessage   String?             @db.Text
  attemptCount   Int                 @default(1)
  nextAttemptAt  DateTime?
  sentAt         DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([notificationId])
  @@index([status])
}

// prisma/schema/organization.prisma

model SchoolProfile {
  id             String         @id @default(uuid())
  userId         String         @unique
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  board          String // CBSE, ICSE, IB, STATE
  address        String
  licenseDocUrl  String?
  approvalStatus ApprovalStatus @default(PENDING_REVIEW)
  approvedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Organization {
  id                 String    @id @default(uuid())
  name               String
  slug               String    @unique
  legalName          String?
  registrationNumber String?
  taxNumber          String?
  logoUrl            String?
  website            String?
  email              String?
  phone              String?
  address            String?
  timezone           String    @default("UTC")
  locale             String    @default("en-US")
  currency           String    @default("USD")
  status             String    @default("ACTIVE") // ACTIVE, SUSPENDED, ARCHIVED
  subscriptionPlan   String    @default("FREE") // FREE, PRO, ENTERPRISE
  subscriptionStatus String    @default("ACTIVE") // ACTIVE, TRIAL, PAST_DUE, CANCELLED
  featureFlags       Json?
  metadata           Json?
  licenseStatus      String    @default("ACTIVE") // ACTIVE, SUSPENDED, EXPIRED
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  schools School[]
}

model School {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name           String
  board          String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  campuses      Campus[]
  academicYears AcademicYear[]
}

model Campus {
  id        String    @id @default(uuid())
  schoolId  String
  school    School    @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  batches Batch[]
}

model AcademicYear {
  id        String    @id @default(uuid())
  schoolId  String
  school    School    @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  startDate DateTime
  endDate   DateTime
  status    String    @default("UPCOMING") // UPCOMING, ACTIVE, ARCHIVED
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  terms       AcademicTerm[]
  batches     Batch[]
  enrollments Enrollment[]
}

model AcademicTerm {
  id             String       @id @default(uuid())
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  name           String // e.g. "Term 1", "Semester 1"
  startDate      DateTime
  endDate        DateTime
  status         String       @default("UPCOMING")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
}

model Class {
  id          String    @id @default(uuid())
  name        String // e.g. "Grade 10"
  code        String?
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  sections    Section[]
  enrollments Enrollment[]
}

model Section {
  id        String    @id @default(uuid())
  classId   String
  class     Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  name      String // e.g. "Section A"
  capacity  Int?      @default(40)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  batches     Batch[]
  enrollments Enrollment[]
}

model Batch {
  id             String       @id @default(uuid())
  campusId       String
  campus         Campus       @relation(fields: [campusId], references: [id], onDelete: Restrict)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  sectionId      String
  section        Section      @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  name           String // e.g. "Grade 10 - Section A (2026)"
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  students    StudentProfile[]
  enrollments Enrollment[]
}

model Enrollment {
  id             String         @id @default(uuid())
  studentId      String
  student        StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId        String
  class          Class          @relation(fields: [classId], references: [id], onDelete: Restrict)
  sectionId      String
  section        Section        @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  batchId        String
  batch          Batch          @relation(fields: [batchId], references: [id], onDelete: Restrict)
  academicYearId String
  academicYear   AcademicYear   @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  rollNumber     String?
  admissionDate  DateTime       @default(now())
  status         String         @default("ACTIVE") // ACTIVE, COMPLETED, WITHDRAWN, TRANSFERRED
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  @@index([studentId])
  @@index([batchId])
  @@index([academicYearId])
}

// prisma/schema/reporting.prisma

enum DashboardRole {
  STUDENT
  TEACHER
  PARENT
  SCHOOL_ADMIN
  ORGANIZATION_ADMIN
  SUPER_ADMIN
}

enum ReportType {
  STUDENT_PROGRESS
  ATTENDANCE
  ASSESSMENT
  ASSIGNMENT
  LEARNING_DNA
  VEDHKRIT_INDEX
  CAREER_READINESS
  TEACHER_PERFORMANCE
  SCHOOL_PERFORMANCE
  ORGANIZATION_PERFORMANCE
  CUSTOM
}

enum ExportFormat {
  PDF
  EXCEL
  CSV
  JSON
}

enum ExportStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum ScheduleFrequency {
  ONE_TIME
  DAILY
  WEEKLY
  MONTHLY
}

model Report {
  id             String            @id @default(uuid())
  organizationId String?
  tenantId       String?
  type           ReportType
  title          String
  description    String?
  config         Json?
  filters        Json?
  isScheduled    Boolean           @default(false)
  frequency      ScheduleFrequency @default(ONE_TIME)
  cronExpression String?
  recipients     String[]
  authorId       String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deletedAt      DateTime?

  @@index([organizationId])
  @@index([tenantId])
  @@index([type])
  @@index([authorId])
}

model Dashboard {
  id             String        @id @default(uuid())
  organizationId String?
  tenantId       String?
  schoolId       String?
  role           DashboardRole
  title          String
  layoutConfig   Json?
  isDefault      Boolean       @default(false)
  ownerId        String?
  widgets        Widget[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  @@index([organizationId])
  @@index([tenantId])
  @@index([schoolId])
  @@index([role])
  @@index([ownerId])
}

model Widget {
  id           String    @id @default(uuid())
  dashboardId  String
  dashboard    Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  title        String
  type         String // KPI, TREND, HEATMAP, RADAR, LEADERBOARD
  metricKey    String
  chartType    String // BAR, LINE, PIE, RADAR, CARD
  gridPosition Json?
  config       Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([dashboardId])
  @@index([metricKey])
}

model AnalyticsSnapshot {
  id                   String   @id @default(uuid())
  organizationId       String?
  tenantId             String?
  schoolId             String?
  studentId            String?
  teacherId            String?
  entityType           String   @default("STUDENT") // STUDENT, TEACHER, SCHOOL, ORG
  overallMasteryScore  Float    @default(0.0)
  attendancePercentage Float    @default(0.0)
  assignmentCompletion Float    @default(0.0)
  learningVelocity     Float    @default(1.0)
  retentionScore       Float    @default(85.0)
  studyTimeMins        Int      @default(0)
  riskLevel            String   @default("LOW") // LOW, MEDIUM, HIGH
  weakTopics           String[]
  strongTopics         String[]
  kpiMetrics           Json?
  heatmapData          Json?
  snapshotDate         DateTime @default(now())
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([organizationId])
  @@index([tenantId])
  @@index([schoolId])
  @@index([studentId])
  @@index([teacherId])
  @@index([snapshotDate])
}

model ExportJob {
  id             String       @id @default(uuid())
  organizationId String?
  tenantId       String?
  reportId       String?
  reportType     ReportType
  format         ExportFormat
  status         ExportStatus @default(QUEUED)
  fileUrl        String?
  fileSize       Int?
  errorMessage   String?
  requestedBy    String
  completedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([tenantId])
  @@index([reportId])
  @@index([requestedBy])
  @@index([status])
}

// prisma/schema/schema.prisma

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  output          = "../../packages/database/generated"
  previewFeatures = ["prismaSchemaFolder"]
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}
