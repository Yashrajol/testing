# Copy this file to `.env` in the same folder before starting the stack:
#   cp apps/api/.env.example apps/api/.env
#
# `.env` is gitignored — never commit real secrets.

PORT=5000

# Any non-empty string works locally. The API refuses to sign tokens without it.
# In production this is a long random value, set on the host (see docs/deployment.md).
JWT_SECRET="local-dev-secret-change-me"

# Docker Compose overrides this to point at the `postgres` service.
# This value is what a natively-run API (npm run dev) uses.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vedhkrit?schema=public"

# "true" makes new signups skip OTP verification and activate immediately.
# Leave false locally so the real OTP flow stays exercised (the code is printed
# to the API logs, since no email provider is wired up yet).
DEMO_MODE=false
