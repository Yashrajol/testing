{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@vedhkrit/config(|/.*)$": "<rootDir>/../../../packages/config/$1",
    "^@vedhkrit/database(|/.*)$": "<rootDir>/../../../packages/database/$1",
    "^@vedhkrit/logging(|/.*)$": "<rootDir>/../../../packages/logging/src/$1",
    "^@vedhkrit/exceptions(|/.*)$": "<rootDir>/../../../packages/exceptions/src/$1",
    "^@vedhkrit/cache(|/.*)$": "<rootDir>/../../../packages/cache/src/$1",
    "^@vedhkrit/storage(|/.*)$": "<rootDir>/../../../packages/storage/src/$1",
    "^@vedhkrit/messaging(|/.*)$": "<rootDir>/../../../packages/messaging/src/$1",
    "^@vedhkrit/events(|/.*)$": "<rootDir>/../../../packages/events/src/$1",
    "^@vedhkrit/auditing(|/.*)$": "<rootDir>/../../../packages/auditing/src/$1",
    "^@vedhkrit/pagination(|/.*)$": "<rootDir>/../../../packages/pagination/src/$1",
    "^@vedhkrit/validation(|/.*)$": "<rootDir>/../../../packages/validation/src/$1",
    "^@vedhkrit/telemetry(|/.*)$": "<rootDir>/../../../packages/telemetry/src/$1",
    "^@vedhkrit/common(|/.*)$": "<rootDir>/../../../packages/common/src/$1"
  }
}
