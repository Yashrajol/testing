{
  "name": "@vedhkrit/database",
  "version": "1.0.0",
  "private": true,
  "description": "Production-Grade Shared Database Layer and Prisma Client Wrapper for VEDHKRIT Platform",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "prisma generate --schema ../../prisma/schema && tsc && node -e \"require('fs').cpSync('./generated', './dist/generated', {recursive: true})\"",
    "generate": "prisma generate --schema ../../prisma/schema",
    "db:generate": "prisma generate --schema ../../prisma/schema",
    "db:push": "prisma db push --schema ../../prisma/schema",
    "db:migrate": "prisma migrate dev --schema ../../prisma/schema",
    "db:studio": "prisma studio --schema ../../prisma/schema",
    "db:seed": "ts-node seed.ts",
    "db:reset": "prisma migrate reset --schema ../../prisma/schema --force",
    "db:format": "prisma format --schema ../../prisma/schema",
    "db:validate": "prisma validate --schema ../../prisma/schema"
  },
  "prisma": {
    "seed": "ts-node seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.0.0",
    "@nestjs/core": "11.1.18",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.11.0",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}