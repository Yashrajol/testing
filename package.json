{
  "name": "vedhkrit-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Production-Grade VEDKHRIT Learner Development Platform Monorepo Workspace",
  "workspaces": [
    "backend",
    "frontend",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@vedhkrit/frontend",
    "dev:backend": "node backend/src/main.js",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\""
  },
  "dependencies": {
    "@rolldown/binding-win32-x64-msvc": "1.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rolldown": "1.2.0"
  },
  "devDependencies": {
    "prettier": "^3.2.5",
    "turbo": "^1.13.0"
  }
}
