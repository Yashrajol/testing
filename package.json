{
  "name": "vedhkrit-frontend-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "VEDHKRIT Learner Development Platform Frontend",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@vedhkrit/frontend",
    "build": "npm run build --workspace=@vedhkrit/frontend",
    "lint": "npm run lint --workspace=@vedhkrit/frontend",
    "format": "prettier --write \"frontend/**/*.{ts,tsx,js,jsx,json,md,css}\""
  }
}
